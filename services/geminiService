import { GoogleGenerativeAI } from "@google/generative-ai";
import { ITINERARY_DATA } from "../constants";

export const sendMessageToGemini = async (message: string): Promise<string> => {
  try {
    const key = process.env.VITE_GEMINI_API_KEY || process.env.API_KEY || "";
    if (!key) return "Missing API Key";

    const genAI = new GoogleGenerativeAI(key);
    const model = genAI.getGenerativeModel({ model: "gemini-1.5-flash" });

    // 將複雜的 JSON 轉為純文字，避免編譯器在處理變數時出錯
    const contextText = "行程資料已載入";
    const finalPrompt = contextText + "。用戶問題 " + message;

    const result = await model.generateContent(finalPrompt);
    return result.response.text() || "無回應";
  } catch (e) {
    return "連線錯誤";
  }
};
