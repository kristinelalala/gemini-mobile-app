import { GoogleGenerativeAI } from "@google/generative-ai";
import { ITINERARY_DATA } from "../constants";

const ITINERARY_CONTEXT = JSON.stringify(ITINERARY_DATA, null, 2);

const SYSTEM_INSTRUCTION = `你是一位專業的導遊。用戶的旅遊行程如下：${ITINERARY_CONTEXT}。請務必使用繁體中文回答用戶關於行程的問題。`;

export const sendMessageToGemini = async (message: string): Promise<string> => {
  try {
    const apiKey = process.env.VITE_GEMINI_API_KEY || process.env.API_KEY;
    if (!apiKey) return "API 金鑰缺失";

    const genAI = new GoogleGenerativeAI(apiKey);
    // 使用最基礎的傳參方式，避免 Vercel 編譯器報錯
    const model = genAI.getGenerativeModel({ model: "gemini-1.5-flash" });

    const prompt = `系統指令：${SYSTEM_INSTRUCTION}\n\n用戶問題：${message}`;
    const result = await model.generateContent(prompt);
    const response = await result.response;
    return response.text() || "抱歉，我暫時無法回答。";
  } catch (error) {
    console.error("Error:", error);
    return "連線發生錯誤。";
  }
};
