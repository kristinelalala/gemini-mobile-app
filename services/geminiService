// @ts-nocheck
export const sendMessageToGemini = async (msg) => {
  try {
    const apiK = process.env.VITE_GEMINI_API_KEY || "";
    if (!apiK) return "Missing Key";

    const fetchUrl = "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=" + apiK;
    
    const reqBody = {
      contents: [{ parts: [{ text: "請用繁體中文回答：" + msg }] }]
    };

    const res = await fetch(fetchUrl, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(reqBody)
    });

    const resData = await res.json();
    return resData.candidates[0].content.parts[0].text || "No response";
  } catch (err) {
    return "Error";
  }
};
